units   metal
atom_style atomic
newton on

read_data in.data

pair_style grace/fs
pair_coeff * * /projappl/project_2006015/julewolf/GRACE_potentials/exported_GRACE-FS-OMAT.yaml Li Mn O

mass 1 6.9400
mass 2 54.9380
mass 3 15.9990

neighbor 2.0 bin
neigh_modify delay 0 every 1 check yes

variable Ti equal 273
variable Tp equal 1273
variable Tc equal 300
variable dt equal 0.002

velocity all create ${Ti} 978653 loop geom

# ------------------------------------
# Equilibration at 300 K
# ------------------------------------

fix 1 all npt temp ${Ti} ${Ti} 0.2 iso 0 0 2

timestep ${dt}

thermo 100
thermo_style custom step temp epair pe ke etotal press vol
thermo_modify lost warn

run 10000

# ------------------------------------
# Heating
# ------------------------------------

unfix 1

fix 1 all npt temp ${Tp} ${Tp} 0.2 iso 0 0 2

dump heatDump all custom 1000 heat_dump.lammpstrj id type xu yu zu
dump_modify heatDump element Li Mn O

run 1000000

undump heatDump

# ------------------------------------
# Refroidissement vers 1000 K
# ------------------------------------

unfix 1

fix 1 all npt temp ${Tc} ${Tc} 0.2 iso 0 0 2

dump coolDump all custom 1000 cool_dump.lammpstrj id type xu yu zu
dump_modify coolDump element Li Mn O

run 1000000

undump coolDump

unfix 1
